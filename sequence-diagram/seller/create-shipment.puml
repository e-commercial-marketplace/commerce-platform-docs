@startuml
!include https://static.visual-paradigm.com/web/resources/plantuml-stdlib/themes/vp.puml
title Create Shipment Sequence Diagram

skinparam backgroundColor white
skinparam sequence {
    ArrowColor black
    LifeLineBorderColor #555555
    LifeLineBackgroundColor white
    ActivationBorderColor #333333
    ActivationBackgroundColor #70C5E8
}

actor "Seller" as A
boundary "Spring Security" as SEC
control "SellerShipmentController" as CT
control "ShipmentService" as SV
entity "UserRepository" as USERS
entity "OrderItemRepository" as ITEMS
entity "CarrierRepository" as CARRIERS
entity "ShipmentRepository" as REPO
database "PostgreSQL" as DB

autonumber

A -> SEC: POST /api/v1/seller/shipments
activate SEC
note over SEC
validate the JWT and load AuthUser into the SecurityContext
end note
alt Token missing, expired or invalid
SEC --> A: 401 AUTHENTICATION_REQUIRED
else Caller is not SELLER
SEC --> A: 403 FORBIDDEN
else Token and role accepted
SEC -> CT: Forward the authenticated SELLER principal
deactivate SEC
activate CT
CT -> SV: createShipment(sellerId, request)
activate SV
alt Request succeeds
SV -> USERS: getApprovedSeller(token id)
USERS -> DB: SELECT users
SV -> ITEMS: Lock the lines, ordered by id, and check them
ITEMS -> DB: SELECT order_items FOR UPDATE
SV -> REPO: existsByOrderIdAndSellerId
SV -> CARRIERS: Resolve the active carrier for PLATFORM_DELIVERY
CARRIERS -> DB: SELECT carriers
SV -> REPO: saveAndFlush the shipment and its lines
REPO -> DB: INSERT shipments and shipment_order_items
SV --> CT: Use-case result
CT --> SEC: 201 Created ApiResponse<ShipmentResponse>
SEC --> A: 201 Created ApiResponse<ShipmentResponse>
else Invalid lines, existing shipment, or invalid method and carrier
SV --> CT: BusinessException
CT --> SEC: 400 VALIDATION_ERROR
SEC --> A: 400 VALIDATION_ERROR
else Seller not APPROVED (checked in the database)
SV --> CT: BusinessException
CT --> SEC: 403 FORBIDDEN
SEC --> A: 403 FORBIDDEN
else A line belongs to another seller
SV --> CT: BusinessException
CT --> SEC: 403 FORBIDDEN
SEC --> A: 403 FORBIDDEN
else Unknown order or line
SV --> CT: BusinessException
CT --> SEC: 404 RESOURCE_NOT_FOUND
SEC --> A: 404 RESOURCE_NOT_FOUND
end
end

@enduml
