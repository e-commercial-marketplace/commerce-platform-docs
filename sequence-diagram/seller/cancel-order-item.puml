@startuml
!include https://static.visual-paradigm.com/web/resources/plantuml-stdlib/themes/vp.puml
title Cancel Order Item Sequence Diagram

skinparam backgroundColor white
skinparam sequence {
    ArrowColor black
    LifeLineBorderColor #555555
    LifeLineBackgroundColor white
    ActivationBorderColor #333333
    ActivationBackgroundColor #70C5E8
}

actor "Seller" as A
boundary "Spring Security" as SEC
control "SellerOrderController" as CT
control "SellerOrderService" as SV
entity "UserRepository" as USERS
entity "OrderItemRepository" as ITEMS
control "OrderService" as ORDERS
control "ProductService" as PRODUCTS
database "PostgreSQL" as DB

autonumber

A -> SEC: PATCH /api/v1/seller/order-items/{id}/cancel
activate SEC
note over SEC
validate the JWT and load AuthUser into the SecurityContext
end note
alt Token missing, expired or invalid
SEC --> A: 401 AUTHENTICATION_REQUIRED
else Caller is not SELLER
SEC --> A: 403 FORBIDDEN
else Token and role accepted
SEC -> CT: Forward the authenticated SELLER principal
deactivate SEC
activate CT
CT -> SV: cancelOrderItem(sellerId, itemId, reason)
activate SV
alt Request succeeds
SV -> USERS: getApprovedSeller(token id)
USERS -> DB: SELECT users
SV -> ITEMS: Lock the order item and check the seller
ITEMS -> DB: SELECT order_items FOR UPDATE
SV -> ORDERS: cancelOrderItem(item, reason)
SV -> PRODUCTS: increaseStock (clears the product detail cache)
PRODUCTS -> DB: UPDATE products
SV -> ORDERS: recalculateTotalsAfterCancel(order)
ORDERS -> DB: UPDATE orders and payments
SV --> CT: Use-case result
CT --> SEC: 200 OK ApiResponse<OrderItemResponse>
SEC --> A: 200 OK ApiResponse<OrderItemResponse>
else Already cancelled
SV --> CT: BusinessException
CT --> SEC: 400 VALIDATION_ERROR
SEC --> A: 400 VALIDATION_ERROR
else Seller not APPROVED (checked in the database)
SV --> CT: BusinessException
CT --> SEC: 403 FORBIDDEN
SEC --> A: 403 FORBIDDEN
else Another seller's line
SV --> CT: BusinessException
CT --> SEC: 403 FORBIDDEN
SEC --> A: 403 FORBIDDEN
else Unknown line
SV --> CT: BusinessException
CT --> SEC: 404 RESOURCE_NOT_FOUND
SEC --> A: 404 RESOURCE_NOT_FOUND
else Line already in a shipment
SV --> CT: BusinessException
CT --> SEC: 409 CANNOT_CANCEL_AFTER_SHIPMENT
SEC --> A: 409 CANNOT_CANCEL_AFTER_SHIPMENT
else Order already paid
SV --> CT: BusinessException
CT --> SEC: 409 CANNOT_CANCEL_AFTER_PAYMENT
SEC --> A: 409 CANNOT_CANCEL_AFTER_PAYMENT
end
end

@enduml
