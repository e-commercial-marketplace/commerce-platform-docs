@startuml
!include https://static.visual-paradigm.com/web/resources/plantuml-stdlib/themes/vp.puml
title Update Product Sequence Diagram

skinparam backgroundColor white
skinparam sequence {
    ArrowColor black
    LifeLineBorderColor #555555
    LifeLineBackgroundColor white
    ActivationBorderColor #333333
    ActivationBackgroundColor #70C5E8
}

actor "Seller" as A
boundary "Spring Security" as SEC
control "SellerProductController" as CT
control "SellerProductService" as SV
entity "UserRepository" as USERS
entity "ProductRepository" as REPO
database "Redis cache" as CACHE
database "PostgreSQL" as DB

autonumber

A -> SEC: PATCH /api/v1/seller/products/{id}
activate SEC
note over SEC
validate the JWT and load AuthUser into the SecurityContext
end note
alt Token missing, expired or invalid
SEC --> A: 401 AUTHENTICATION_REQUIRED
else Caller is not SELLER
SEC --> A: 403 FORBIDDEN
else Token and role accepted
SEC -> CT: Forward the authenticated SELLER principal
deactivate SEC
activate CT
CT -> SV: updateProduct(sellerId, id, request)
activate SV
alt Request succeeds
SV -> USERS: getApprovedSeller(token id)
USERS -> DB: SELECT users
SV -> REPO: Find the product and check the owner
REPO -> DB: SELECT products
SV -> REPO: Change the sent fields
REPO -> DB: UPDATE products
SV -> CACHE: Evict the shop and product detail entries after commit
SV --> CT: Use-case result
CT --> SEC: 200 OK ApiResponse<ProductResponse>
SEC --> A: 200 OK ApiResponse<ProductResponse>
else Invalid data, unknown category, listed product without image, or changed image URL not allowed
SV --> CT: BusinessException
CT --> SEC: 400 VALIDATION_ERROR
SEC --> A: 400 VALIDATION_ERROR
else Seller not APPROVED (checked in the database)
SV --> CT: BusinessException
CT --> SEC: 403 FORBIDDEN
SEC --> A: 403 FORBIDDEN
else Another seller's product
SV --> CT: BusinessException
CT --> SEC: 403 FORBIDDEN
SEC --> A: 403 FORBIDDEN
else Unknown product
SV --> CT: BusinessException
CT --> SEC: 404 RESOURCE_NOT_FOUND
SEC --> A: 404 RESOURCE_NOT_FOUND
end
end

@enduml
