@startuml
!include https://static.visual-paradigm.com/web/resources/plantuml-stdlib/themes/vp.puml
title Manage Categories Sequence Diagram

skinparam backgroundColor white
skinparam sequence {
    ArrowColor black
    LifeLineBorderColor #555555
    LifeLineBackgroundColor white
    ActivationBorderColor #333333
    ActivationBackgroundColor #70C5E8
}

actor "Admin" as A
boundary "Spring Security" as SEC
control "AdminCategoryController" as CT
control "CategoryService" as SV
entity "CategoryRepository" as REPO
database "PostgreSQL" as DB

autonumber

A -> SEC: GET /api/v1/categories, POST/PATCH/DELETE /api/v1/admin/categories
activate SEC
note over SEC
validate the JWT and load AuthUser into the SecurityContext
end note
alt Token missing, expired or invalid
SEC --> A: 401 AUTHENTICATION_REQUIRED
else Caller is not ADMIN
SEC --> A: 403 FORBIDDEN
else Token and role accepted
SEC -> CT: Forward the authenticated ADMIN principal
deactivate SEC
activate CT
CT -> SV: Run the chosen category operation
activate SV
note over A,SV
See view-categories, create-category, update-category and delete-category
end note
SV -> REPO: Read or change categories
REPO -> DB: SELECT, INSERT, UPDATE or DELETE categories
SV --> CT: Use-case result
CT --> SEC: Response of the chosen operation
SEC --> A: Response of the chosen operation
end

@enduml
