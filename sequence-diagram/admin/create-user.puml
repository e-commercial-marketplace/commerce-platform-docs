@startuml
!include https://static.visual-paradigm.com/web/resources/plantuml-stdlib/themes/vp.puml
title Create User Sequence Diagram

skinparam backgroundColor white
skinparam sequence {
    ArrowColor black
    LifeLineBorderColor #555555
    LifeLineBackgroundColor white
    ActivationBorderColor #333333
    ActivationBackgroundColor #70C5E8
}

actor "Admin" as A
boundary "Spring Security" as SEC
control "AdminUserController" as CT
control "AdminUserService" as SV
entity "UserRepository" as REPO
database "PostgreSQL" as DB

autonumber

A -> SEC: POST /api/v1/admin/users
activate SEC
note over SEC
validate the JWT and load AuthUser into the SecurityContext
end note
alt Token missing, expired or invalid
SEC --> A: 401 AUTHENTICATION_REQUIRED
else Caller is not ADMIN
SEC --> A: 403 FORBIDDEN
else Token and role accepted
SEC -> CT: Forward the authenticated ADMIN principal
deactivate SEC
activate CT
CT -> SV: createUser(request)
activate SV
alt Request succeeds
SV -> REPO: existsByEmailIgnoreCase
SV -> REPO: saveAndFlush with the BCrypt hash
REPO -> DB: INSERT users
SV --> CT: Use-case result
CT --> SEC: 201 Created ApiResponse<UserResponse>
SEC --> A: 201 Created ApiResponse<UserResponse>
else Invalid body or email already used
SV --> CT: BusinessException
CT --> SEC: 400 VALIDATION_ERROR
SEC --> A: 400 VALIDATION_ERROR
end
end

@enduml
