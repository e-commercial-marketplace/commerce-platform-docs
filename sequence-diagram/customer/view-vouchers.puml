@startuml
!include https://static.visual-paradigm.com/web/resources/plantuml-stdlib/themes/vp.puml
title View Vouchers Sequence Diagram

skinparam backgroundColor white
skinparam sequence {
    ArrowColor black
    LifeLineBorderColor #555555
    LifeLineBackgroundColor white
    ActivationBorderColor #333333
    ActivationBackgroundColor #70C5E8
}

actor "Guest or Customer" as A
boundary "Spring Security" as SEC
control "VoucherController" as CT
control "VoucherService" as SV
entity "VoucherRepository" as REPO
database "PostgreSQL" as DB

autonumber

A -> SEC: GET /api/v1/vouchers?page&size
activate SEC
note over SEC
public GET: no token required
end note
SEC -> CT: Forward the request
deactivate SEC
activate CT
CT -> SV: listUsableVouchers(page, size)
activate SV
alt Request succeeds
SV -> REPO: findUsable(now, pageable)
REPO -> DB: SELECT vouchers within validity with uses left, highest percent first
SV --> CT: Use-case result
CT --> SEC: 200 OK ApiResponse<PageResponse<VoucherSummaryResponse>>
SEC --> A: 200 OK ApiResponse<PageResponse<VoucherSummaryResponse>>
else Invalid page or size
CT --> SEC: 400 VALIDATION_ERROR
SEC --> A: 400 VALIDATION_ERROR
end

@enduml
