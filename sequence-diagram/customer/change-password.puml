@startuml
!include https://static.visual-paradigm.com/web/resources/plantuml-stdlib/themes/vp.puml
title Change Password Sequence Diagram

skinparam backgroundColor white
skinparam sequence {
    ArrowColor black
    LifeLineBorderColor #555555
    LifeLineBackgroundColor white
    ActivationBorderColor #333333
    ActivationBackgroundColor #70C5E8
}

actor "Customer" as A
boundary "Spring Security" as SEC
control "UserController" as CT
control "AuthService" as SV
entity "UserRepository" as REPO
control "RefreshTokenService" as TOKENS
database "PostgreSQL" as DB

autonumber

A -> SEC: PATCH /api/v1/users/me/password
activate SEC
note over SEC
validate the JWT and load AuthUser into the SecurityContext
end note
alt Token missing, expired or invalid
SEC --> A: 401 AUTHENTICATION_REQUIRED
else Token and role accepted
SEC -> CT: Forward the authenticated authenticated user principal
deactivate SEC
activate CT
CT -> SV: changePassword(callerId, request)
activate SV
alt Request succeeds
SV -> REPO: Load the caller
REPO -> DB: SELECT users
SV -> SV: Verify the current password and that the new one differs
SV -> REPO: Set the new password hash
REPO -> DB: UPDATE users
SV -> TOKENS: Revoke all, then create a new refresh token
TOKENS -> DB: UPDATE and INSERT refresh_tokens
SV --> CT: Use-case result
CT --> SEC: 200 OK ApiResponse<AuthResponse>
SEC --> A: 200 OK ApiResponse<AuthResponse>
else Invalid body, wrong current password or unchanged password
SV --> CT: BusinessException
CT --> SEC: 400 VALIDATION_ERROR
SEC --> A: 400 VALIDATION_ERROR
else Account disabled
SV --> CT: BusinessException
CT --> SEC: 401 AUTHENTICATION_REQUIRED
SEC --> A: 401 AUTHENTICATION_REQUIRED
end
end

@enduml
