@startuml
!include https://static.visual-paradigm.com/web/resources/plantuml-stdlib/themes/vp.puml
title Logout Sequence Diagram

skinparam backgroundColor white
skinparam sequence {
    ArrowColor black
    LifeLineBorderColor #555555
    LifeLineBackgroundColor white
    ActivationBorderColor #333333
    ActivationBackgroundColor #70C5E8
}

actor "Customer" as A
boundary "Spring Security" as SEC
control "AuthController" as CT
control "AuthService" as SV
control "RefreshTokenService" as TOKENS
entity "RefreshTokenRepository" as REPO
database "PostgreSQL" as DB

autonumber

A -> SEC: POST /api/v1/auth/logout
activate SEC
note over SEC
validate the JWT and load AuthUser into the SecurityContext
end note
alt Token missing, expired or invalid
SEC --> A: 401 AUTHENTICATION_REQUIRED
else Token and role accepted
SEC -> CT: Forward the authenticated authenticated user principal
deactivate SEC
activate CT
CT -> SV: logout(request, callerId)
activate SV
alt Request succeeds
SV -> TOKENS: revokeRefreshToken(token, caller)
TOKENS -> REPO: Find the token by SHA-256 hash
REPO -> DB: SELECT refresh_tokens
TOKENS -> REPO: revokeIfActive
REPO -> DB: UPDATE refresh_tokens SET revoked_at
SV --> CT: Use-case result
CT --> SEC: 200 OK ApiResponse<Void>
SEC --> A: 200 OK ApiResponse<Void>
else Unknown, revoked or foreign refresh token
SV --> CT: BusinessException
CT --> SEC: 401 AUTHENTICATION_REQUIRED
SEC --> A: 401 AUTHENTICATION_REQUIRED
end
end

@enduml
