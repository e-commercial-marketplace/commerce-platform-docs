@startuml
!include https://static.visual-paradigm.com/web/resources/plantuml-stdlib/themes/vp.puml
title Add Cart Item Sequence Diagram

skinparam backgroundColor white
skinparam sequence {
    ArrowColor black
    LifeLineBorderColor #555555
    LifeLineBackgroundColor white
    ActivationBorderColor #333333
    ActivationBackgroundColor #70C5E8
}

actor "Customer" as A
boundary "Spring Security" as SEC
control "CartController" as CT
control "CartService" as SV
entity "UserRepository" as USERS
entity "ProductRepository" as PRODUCTS
entity "CartItemRepository" as REPO
database "Redis cache" as CACHE
database "PostgreSQL" as DB

autonumber

A -> SEC: POST /api/v1/cart/items
activate SEC
note over SEC
validate the JWT and load AuthUser into the SecurityContext
end note
alt Token missing, expired or invalid
SEC --> A: 401 AUTHENTICATION_REQUIRED
else Caller is not CUSTOMER
SEC --> A: 403 FORBIDDEN
else Token and role accepted
SEC -> CT: Forward the authenticated CUSTOMER principal
deactivate SEC
activate CT
CT -> SV: addToCart(callerId, request)
activate SV
alt Request succeeds
SV -> USERS: Lock the customer row (serializes this cart)
USERS -> DB: SELECT users FOR UPDATE
SV -> PRODUCTS: Find the product and check it is listed
PRODUCTS -> DB: SELECT products
SV -> REPO: Save or increase the line
REPO -> DB: INSERT or UPDATE cart_items
SV -> CACHE: Evict the cart after commit
SV --> CT: Use-case result
CT --> SEC: 200 OK ApiResponse<CartResponse>
SEC --> A: 200 OK ApiResponse<CartResponse>
else Invalid body
SV --> CT: BusinessException
CT --> SEC: 400 VALIDATION_ERROR
SEC --> A: 400 VALIDATION_ERROR
else Unknown product
SV --> CT: BusinessException
CT --> SEC: 404 RESOURCE_NOT_FOUND
SEC --> A: 404 RESOURCE_NOT_FOUND
else Hidden product
SV --> CT: BusinessException
CT --> SEC: 400 PRODUCT_INACTIVE
SEC --> A: 400 PRODUCT_INACTIVE
else Total above stock
SV --> CT: BusinessException
CT --> SEC: 409 INSUFFICIENT_STOCK
SEC --> A: 409 INSUFFICIENT_STOCK
end
end

@enduml
