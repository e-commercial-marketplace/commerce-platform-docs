@startuml
!include https://static.visual-paradigm.com/web/resources/plantuml-stdlib/themes/vp.puml

title Category - Create Category

skinparam shadowing false
skinparam backgroundColor white
skinparam activityFontName Arial
skinparam activityFontSize 14
skinparam activityBorderThickness 1.5
skinparam ArrowThickness 1.5
skinparam ArrowColor #222222
skinparam SwimlaneBorderColor #222222
skinparam SwimlaneBorderThickness 2
skinparam activity {
  BackgroundColor #7DD3FC
  BorderColor #2563EB
  DiamondBackgroundColor #7DD3FC
  DiamondBorderColor #2563EB
  StartColor #111827
  EndColor #FFFFFF
}

|Admin|
start
note right
Precondition:
The admin is signed in.

Postcondition:
The category exists and the categories cache is cleared.
end note
:Open the category form;
|System|
:Display the form;
|Admin|
repeat
:Enter the category name;
:Submit the category;
|System|
if (The system fails while processing the request?) then (Yes)
  :Return the system error;
  |Admin|
  :View the system error;
  stop
else (No)
endif
|System|
:Check the name is not blank and is free;
backward :Return the validation error;
repeat while (The name is blank or taken?) is (Yes) not (No)
:Save the category and return the result;
|Admin|
:View the result;
stop

@enduml
