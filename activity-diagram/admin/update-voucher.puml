@startuml
!include https://static.visual-paradigm.com/web/resources/plantuml-stdlib/themes/vp.puml

title Voucher - Update Voucher

skinparam shadowing false
skinparam backgroundColor white
skinparam activityFontName Arial
skinparam activityFontSize 14
skinparam activityBorderThickness 1.5
skinparam ArrowThickness 1.5
skinparam ArrowColor #222222
skinparam SwimlaneBorderColor #222222
skinparam SwimlaneBorderThickness 2
skinparam activity {
  BackgroundColor #7DD3FC
  BorderColor #2563EB
  DiamondBackgroundColor #7DD3FC
  DiamondBorderColor #2563EB
  StartColor #111827
  EndColor #FFFFFF
}

|Admin|
start
note right
Precondition:
Admin is authenticated.

Postcondition:
Voucher information is updated.
end note
:Open the voucher update function;
|System|
:Display the current information and the allowed operations;
|Admin|
repeat
  :Select the item to edit and enter the changes;
  :Submit or confirm the request;
  |System|
  if (The system fails to process the request?) then (Yes)
    :Return the system error;
    |Admin|
    :View the system error;
    stop
  else (No)
  endif
  |System|
  :Check the information, the processing conditions, and the permission;
  if (The information is valid?) then (No)
    :Return the invalid-information notice and do not save the changes;
    |Admin|
    :View the invalid-information notice;
  else (Yes)
    |System|
    :Save the changes to the information;
    :Display the result;
    |Admin|
    :View the result;
    stop
  endif
  |Admin|
  :Correct the information;
repeat while (Submit\nagain?) is (Yes) not (No)
stop

@enduml
