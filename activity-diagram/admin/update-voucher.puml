@startuml
!include https://static.visual-paradigm.com/web/resources/plantuml-stdlib/themes/vp.puml

title Voucher - Update Voucher

skinparam shadowing false
skinparam backgroundColor white
skinparam activityFontName Arial
skinparam activityFontSize 14
skinparam activityBorderThickness 1.5
skinparam ArrowThickness 1.5
skinparam ArrowColor #222222
skinparam SwimlaneBorderColor #222222
skinparam SwimlaneBorderThickness 2
skinparam activity {
  BackgroundColor #7DD3FC
  BorderColor #2563EB
  DiamondBackgroundColor #7DD3FC
  DiamondBorderColor #2563EB
  StartColor #111827
  EndColor #FFFFFF
}

|Admin|
start
note right
Precondition:
The admin is signed in.

Postcondition:
The voucher is updated.
end note
:Choose a voucher to edit;
|System|
:Display the current data;
|Admin|
repeat
:Change the fields;
:Submit the update;
|System|
if (The system fails while processing the request?) then (Yes)
  :Return the system error;
  |Admin|
  :View the system error;
  stop
else (No)
endif
|System|
:Check the voucher exists and the changes are allowed;
if (The voucher is unknown?) then (Yes)
  :Return the not-found error;
  |Admin|
  :View the message;
  stop
else (No)
endif
|System|
backward :Return the validation error;
repeat while (The percent of a used voucher\nchanges, the dates are wrong,\nor the limit is below the uses?) is (Yes) not (No)
:Save the changes and return the result;
|Admin|
:View the result;
stop

@enduml
