@startuml
!include https://static.visual-paradigm.com/web/resources/plantuml-stdlib/themes/vp.puml

title Shipment - Manage Carriers

skinparam shadowing false
skinparam backgroundColor white
skinparam activityFontName Arial
skinparam activityFontSize 14
skinparam activityBorderThickness 1.5
skinparam ArrowThickness 1.5
skinparam ArrowColor #222222
skinparam SwimlaneBorderColor #222222
skinparam SwimlaneBorderThickness 2
skinparam activity {
  BackgroundColor #7DD3FC
  BorderColor #2563EB
  DiamondBackgroundColor #7DD3FC
  DiamondBorderColor #2563EB
  StartColor #111827
  EndColor #FFFFFF
}

|Admin|
start
note right
Precondition:
Admin is authenticated.

Postcondition:
The carrier list is updated. Sellers see
only active carriers.
end note
:Open the carrier management function;
|System|
:Display every carrier, active or not;
|Admin|
repeat
  :Add a carrier, or rename, activate or deactivate one;
  :Submit or confirm the request;
  |System|
  :Check the information, processing conditions, and permission;
  if (The system fails to process the request?) then (Yes)
    :Return the system error;
    |Admin|
    :View the error message;
    stop
  else (No)
  endif
  |System|
  if (The name is missing, too long or already used?) then (Yes)
    :Return the invalid-information notice and do not save the changes;
    |Admin|
    :View the notice;
  else (No)
    |System|
    :Save the carrier;
    :Display the result;
    |Admin|
    :View the result;
    stop
  endif
  |Admin|
  :Correct the information;
repeat while (Submit\nagain?) is (Yes) not (No)
stop

@enduml
