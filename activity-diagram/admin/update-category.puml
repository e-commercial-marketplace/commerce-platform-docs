@startuml
!include https://static.visual-paradigm.com/web/resources/plantuml-stdlib/themes/vp.puml

title Category - Update Category

skinparam shadowing false
skinparam backgroundColor white
skinparam activityFontName Arial
skinparam activityFontSize 14
skinparam activityBorderThickness 1.5
skinparam ArrowThickness 1.5
skinparam ArrowColor #222222
skinparam SwimlaneBorderColor #222222
skinparam SwimlaneBorderThickness 2
skinparam activity {
  BackgroundColor #7DD3FC
  BorderColor #2563EB
  DiamondBackgroundColor #7DD3FC
  DiamondBorderColor #2563EB
  StartColor #111827
  EndColor #FFFFFF
}

|Admin|
start
note right
Precondition:
The admin is signed in.

Postcondition:
The name changes; the categories and product detail
caches are cleared.
end note
:Choose a category to rename;
|System|
:Display the current name;
|Admin|
repeat
:Enter the new name;
:Submit the update;
|System|
if (The system fails while processing the request?) then (Yes)
  :Return the system error;
  |Admin|
  :View the system error;
  stop
else (No)
endif
|System|
:Check the category exists and the name is free;
if (The category is unknown?) then (Yes)
  :Return the not-found error;
  |Admin|
  :View the message;
  stop
else (No)
endif
|System|
backward :Return the validation error;
repeat while (The name is blank or taken?) is (Yes) not (No)
:Save the name and return the result;
|Admin|
:View the result;
stop

@enduml
