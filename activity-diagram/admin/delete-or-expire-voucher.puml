@startuml
!include https://static.visual-paradigm.com/web/resources/plantuml-stdlib/themes/vp.puml

title Voucher - Delete or Expire Voucher

skinparam shadowing false
skinparam backgroundColor white
skinparam activityFontName Arial
skinparam activityFontSize 14
skinparam activityBorderThickness 1.5
skinparam ArrowThickness 1.5
skinparam ArrowColor #222222
skinparam SwimlaneBorderColor #222222
skinparam SwimlaneBorderThickness 2
skinparam activity {
  BackgroundColor #7DD3FC
  BorderColor #2563EB
  DiamondBackgroundColor #7DD3FC
  DiamondBorderColor #2563EB
  StartColor #111827
  EndColor #FFFFFF
}

|Admin|
start
note right
Precondition:
Admin is authenticated.

Postcondition:
The voucher is deleted or its validity
is ended according to the chosen action.
end note
:Open the voucher deletion or expiry function;
|System|
:Display the current selection and the allowed actions;
|Admin|
:Select the item to delete or expire;
:Submit or confirm the request;
|System|
:Check the information, processing conditions, and permission;
if (The system fails to process the request?) then (Yes)
  :Return the system error;
  |Admin|
  :View the error message;
  stop
else (No)
endif
|System|
:Delete the voucher or end its validity according to the Admin's choice;
:Display the result;
|Admin|
:View the result;
stop

@enduml
