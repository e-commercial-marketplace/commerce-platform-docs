@startuml
!include https://static.visual-paradigm.com/web/resources/plantuml-stdlib/themes/vp.puml

title Voucher - Create Voucher

skinparam shadowing false
skinparam backgroundColor white
skinparam activityFontName Arial
skinparam activityFontSize 14
skinparam activityBorderThickness 1.5
skinparam ArrowThickness 1.5
skinparam ArrowColor #222222
skinparam SwimlaneBorderColor #222222
skinparam SwimlaneBorderThickness 2
skinparam activity {
  BackgroundColor #7DD3FC
  BorderColor #2563EB
  DiamondBackgroundColor #7DD3FC
  DiamondBorderColor #2563EB
  StartColor #111827
  EndColor #FFFFFF
}

|Admin|
start
note right
Precondition:
The admin is signed in.

Postcondition:
The voucher exists with no use yet.
end note
:Open the voucher form;
|System|
:Display the form;
|Admin|
repeat
:Enter code, description, percent, validity and usage limit;
:Submit the voucher;
|System|
if (The system fails while processing the request?) then (Yes)
  :Return the system error;
  |Admin|
  :View the system error;
  stop
else (No)
endif
|System|
:Check the data is valid, the start is before the end and the code is free;
backward :Return the validation error;
repeat while (The data is invalid or the\ncode is taken?) is (Yes) not (No)
:Save the voucher and return the result;
|Admin|
:View the result;
stop

@enduml
