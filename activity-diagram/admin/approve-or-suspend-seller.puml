@startuml
!include https://static.visual-paradigm.com/web/resources/plantuml-stdlib/themes/vp.puml

title User - Approve or Suspend Seller

skinparam shadowing false
skinparam backgroundColor white
skinparam activityFontName Arial
skinparam activityFontSize 14
skinparam activityBorderThickness 1.5
skinparam ArrowThickness 1.5
skinparam ArrowColor #222222
skinparam SwimlaneBorderColor #222222
skinparam SwimlaneBorderThickness 2
skinparam activity {
  BackgroundColor #7DD3FC
  BorderColor #2563EB
  DiamondBackgroundColor #7DD3FC
  DiamondBorderColor #2563EB
  StartColor #111827
  EndColor #FFFFFF
}

|Admin|
start
note right
Precondition:
Admin is authenticated.

Postcondition:
The seller status is updated according
to the Admin's decision.
end note
:Open the seller approval or suspension function;
|System|
:Display the current seller status and the allowed actions;
|Admin|
repeat
  :Select the information or action to process;
  :Submit or confirm the request;
  |System|
  :Check the information, processing conditions, and permission;
  if (The system fails to process the request?) then (Yes)
    :Return the system error;
    |Admin|
    :View the error message;
    stop
  else (No)
  endif
  |System|
  if (The seller status has already changed?) then (Yes)
    :Return the status-cannot-be-changed notice;
    |Admin|
    :View the notice;
  else (No)
    |System|
    :Update the seller status;
    :Display the result;
    |Admin|
    :View the result;
    stop
  endif
  |Admin|
  :Reload the list and review again;
repeat while (Submit another\nrequest?) is (Yes) not (No)
stop

@enduml
