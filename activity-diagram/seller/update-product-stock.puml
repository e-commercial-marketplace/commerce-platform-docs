@startuml
!include https://static.visual-paradigm.com/web/resources/plantuml-stdlib/themes/vp.puml

title Catalog - Update Product Stock

skinparam shadowing false
skinparam backgroundColor white
skinparam activityFontName Arial
skinparam activityFontSize 14
skinparam activityBorderThickness 1.5
skinparam ArrowThickness 1.5
skinparam ArrowColor #222222
skinparam SwimlaneBorderColor #222222
skinparam SwimlaneBorderThickness 2
skinparam activity {
  BackgroundColor #7DD3FC
  BorderColor #2563EB
  DiamondBackgroundColor #7DD3FC
  DiamondBorderColor #2563EB
  StartColor #111827
  EndColor #FFFFFF
}

|Seller|
start
note right
Precondition:
The seller is signed in and approved.

Postcondition:
The stock is updated and the detail cache is cleared.
end note
repeat
:Open the product and enter the new stock;
:Submit the update;
|System|
if (The system fails while processing the request?) then (Yes)
  :Return the system error;
  |Seller|
  :View the system error;
  stop
else (No)
endif
|System|
:Check the stock is not negative and the product is the seller's;
if (The product is unknown or another seller's?) then (Yes)
  :Return the error;
  |Seller|
  :View the message;
  stop
else (No)
endif
|System|
backward :Return the validation error;
repeat while (The stock is negative?) is (Yes) not (No)
:Save the new stock;
|Seller|
:View the result;
stop

@enduml
