@startuml
!include https://static.visual-paradigm.com/web/resources/plantuml-stdlib/themes/vp.puml

title Shipment - Create Shipment

skinparam shadowing false
skinparam backgroundColor white
skinparam activityFontName Arial
skinparam activityFontSize 14
skinparam activityBorderThickness 1.5
skinparam ArrowThickness 1.5
skinparam ArrowColor #222222
skinparam SwimlaneBorderColor #222222
skinparam SwimlaneBorderThickness 2
skinparam activity {
  BackgroundColor #7DD3FC
  BorderColor #2563EB
  DiamondBackgroundColor #7DD3FC
  DiamondBorderColor #2563EB
  StartColor #111827
  EndColor #FFFFFF
}

|Seller|
start
note right
Precondition:
Seller is logged in and the data
belongs to the Seller.

Postcondition:
A new shipment is created for the eligible
order items.
end note
:Open the shipment creation function;
|System|
:Display the current shipment information and the allowed operations;
|Seller|
repeat
  :Choose the information or the operation to process;
  :Send or confirm the request;
  |System|
  if (The system fails to process the request?) then (Yes)
    :Return the system error;
    |Seller|
    :View the system error;
    stop
  else (No)
  endif
  |System|
  :Check that each item is confirmed, unassigned, and from this order and Seller;
  if (All selected items are eligible?) then (Yes)
    |System|
    :Create and save the new shipment in the pending state;
    :Display the result;
    |Seller|
    :View the result;
    stop
  else (No)
    :Return the shipment-creation failure notice;
    |Seller|
    :View the shipment-creation failure notice;
  endif
  |Seller|
  :Choose the order items again;
repeat while (Create shipment\nagain?) is (Yes) not (No)
stop

@enduml
