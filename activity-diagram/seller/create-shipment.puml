@startuml
!include https://static.visual-paradigm.com/web/resources/plantuml-stdlib/themes/vp.puml

title Shipment - Create Shipment

skinparam shadowing false
skinparam backgroundColor white
skinparam activityFontName Arial
skinparam activityFontSize 14
skinparam activityBorderThickness 1.5
skinparam ArrowThickness 1.5
skinparam ArrowColor #222222
skinparam SwimlaneBorderColor #222222
skinparam SwimlaneBorderThickness 2
skinparam activity {
  BackgroundColor #7DD3FC
  BorderColor #2563EB
  DiamondBackgroundColor #7DD3FC
  DiamondBorderColor #2563EB
  StartColor #111827
  EndColor #FFFFFF
}

|Seller|
start
note right
Precondition:
The seller is signed in and approved.

Postcondition:
A PENDING shipment exists with fee 0 and holds the
chosen lines.
end note
:Choose the order and the confirmed lines;
:Choose the delivery method and submit;
|System|
if (The system fails while processing the request?) then (Yes)
  :Return the system error;
  |Seller|
  :View the system error;
  stop
else (No)
endif
|System|
:Check the lines are the seller's, in this order, CONFIRMED and not in a shipment;
if (A line is not valid for this shipment?) then (Yes)
  :Return the shipment error;
  |Seller|
  :View the message;
  stop
else (No)
endif
|System|
:Check the seller has no shipment for this order and the method is valid;
if (A shipment already exists or the method is invalid?) then (Yes)
  :Return the shipment error;
  |Seller|
  :View the message;
  stop
else (No)
endif
|System|
:Save the shipment;
|Seller|
:View the result;
stop

@enduml
