@startuml
!include https://static.visual-paradigm.com/web/resources/plantuml-stdlib/themes/vp.puml

title Catalog - Update Product

skinparam shadowing false
skinparam backgroundColor white
skinparam activityFontName Arial
skinparam activityFontSize 14
skinparam activityBorderThickness 1.5
skinparam ArrowThickness 1.5
skinparam ArrowColor #222222
skinparam SwimlaneBorderColor #222222
skinparam SwimlaneBorderThickness 2
skinparam activity {
  BackgroundColor #7DD3FC
  BorderColor #2563EB
  DiamondBackgroundColor #7DD3FC
  DiamondBorderColor #2563EB
  StartColor #111827
  EndColor #FFFFFF
}

|Seller|
start
note right
Precondition:
Seller is logged in and the data
belongs to the Seller.

Postcondition:
The product information is updated.
end note
:Open the product update function;
|System|
:Display the current information and the allowed operations;
|Seller|
repeat
  :Choose the item to edit and enter the changes;
  :Send or confirm the request;
  |System|
  if (The system fails to process the request?) then (Yes)
    :Return the system error;
    |Seller|
    :View the system error;
    stop
  else (No)
    |System|
    :Check the information, the processing conditions, and the permission to perform;
    if (The product information is missing or invalid?) then (Yes)
      :Return the invalid-information notice and do not save the changes;
      |Seller|
      :View the invalid-information notice;
    else (No)
      |System|
      :Save the information changes;
      :Display the result;
      |Seller|
      :View the result;
      stop
    endif
  endif
  |Seller|
  :Correct the information;
repeat while (Update product\nagain?) is (Yes) not (No)
stop

@enduml
