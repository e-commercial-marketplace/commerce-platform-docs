@startuml
!include https://static.visual-paradigm.com/web/resources/plantuml-stdlib/themes/vp.puml

title Shipment - Update Shipment Status

skinparam shadowing false
skinparam backgroundColor white
skinparam activityFontName Arial
skinparam activityFontSize 14
skinparam activityBorderThickness 1.5
skinparam ArrowThickness 1.5
skinparam ArrowColor #222222
skinparam SwimlaneBorderColor #222222
skinparam SwimlaneBorderThickness 2
skinparam activity {
  BackgroundColor #7DD3FC
  BorderColor #2563EB
  DiamondBackgroundColor #7DD3FC
  DiamondBorderColor #2563EB
  StartColor #111827
  EndColor #FFFFFF
}

|Seller|
start
note right
Precondition:
Seller is logged in and the data
belongs to the Seller.

Postcondition:
The shipment status is updated, and
the stock, the order, and the COD are
updated according to the shipment
status.
end note
:Open the shipment-status update function;
|System|
:Display the current shipment status and the allowed operations;
|Seller|
repeat
  :Choose the information or the operation to process;
  :Send or confirm the request;
  |System|
  if (The system fails to process the request?) then (Yes)
    :Return the system error;
    |Seller|
    :View the system error;
    stop
  else (No)
    |System|
    :Validate the status transition, required delivery information, and cancellation/payment rules;
    if (A status rule is violated?) then (Yes)
      :Return the status-rejected notice;
      |Seller|
      :View the status-rejected notice;
    else (No)
      |System|
      if (The package cannot be delivered?) then (Yes)
        :Record the failed delivery and return no stock;
        |Seller|
        :View the result;
        stop
      else (No)
      endif
      |System|
      if (The package has come back to the Seller's warehouse?) then (Yes)
        :Record the returned package and return the shipped quantity;
        |Seller|
        :View the result;
        stop
      else (No)
      endif
      |System|
      if (Unpaid PENDING/PREPARING cancellation?) then (Yes)
        :Cancel the unshipped shipment items;
        :Return stock exactly once;
        :Recalculate the order total and pending COD;
        if (No item remains in the order?) then (Yes)
          :Cancel the order;
        else (No)
        endif
        |Seller|
        :View the result;
        stop
      else (No)
      endif
      |System|
      :Update the shipment status;
      :Recalculate the order status and COD when all mandatory shipments are delivered;
      :Update the stock according to the result without returning goods;
      :Display the update result;
      |Seller|
      :View the result;
      stop
    endif
  endif
  |Seller|
  :Correct the information;
repeat while (Update status\nagain?) is (Yes) not (No)
stop

@enduml
