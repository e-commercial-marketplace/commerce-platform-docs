@startuml
!include https://static.visual-paradigm.com/web/resources/plantuml-stdlib/themes/vp.puml

title Catalog - Browse Catalog

skinparam shadowing false
skinparam backgroundColor white
skinparam activityFontName Arial
skinparam activityFontSize 14
skinparam activityBorderThickness 1.5
skinparam ArrowThickness 1.5
skinparam ArrowColor #222222
skinparam SwimlaneBorderColor #222222
skinparam SwimlaneBorderThickness 2
skinparam activity {
  BackgroundColor #7DD3FC
  BorderColor #2563EB
  DiamondBackgroundColor #7DD3FC
  DiamondBorderColor #2563EB
  StartColor #111827
  EndColor #FFFFFF
}

|Customer|
start
note right
Precondition:
Customer is authenticated.

Postcondition:
None.
end note
:Open the catalog browsing function;
|System|
:Display the information the actor is allowed to view;
if (Catalog data is available?) then (No)
  :Return the no-data notice;
  |Customer|
  :View the no-data notice;
  stop
else (Yes)
endif
|Customer|
:Select the information to view;
|System|
:Load the selected item details;
if (Loading the details fails?) then (Yes)
  :Return the system error;
  |Customer|
  :View the system error;
  stop
else (No)
endif
|System|
:Display the information details;
|Customer|
:View the information;
stop

@enduml
