@startuml
!include https://static.visual-paradigm.com/web/resources/plantuml-stdlib/themes/vp.puml

title Cart - Update Cart Item

skinparam shadowing false
skinparam backgroundColor white
skinparam activityFontName Arial
skinparam activityFontSize 14
skinparam activityBorderThickness 1.5
skinparam ArrowThickness 1.5
skinparam ArrowColor #222222
skinparam SwimlaneBorderColor #222222
skinparam SwimlaneBorderThickness 2
skinparam activity {
  BackgroundColor #7DD3FC
  BorderColor #2563EB
  DiamondBackgroundColor #7DD3FC
  DiamondBorderColor #2563EB
  StartColor #111827
  EndColor #FFFFFF
}

|Customer|
start
note right
Precondition:
The customer is signed in.

Postcondition:
The quantity is updated and the new cart is returned.
end note
repeat
:Enter a new quantity for a line;
:Submit the update;
|System|
if (The system fails while processing the request?) then (Yes)
  :Return the system error;
  |Customer|
  :View the system error;
  stop
else (No)
endif
|System|
:Check the line is the customer's, the product is listed and has stock;
backward :Return the update error;
repeat while (The line is unknown or\nforeign, the product is hidden\nor short of stock?) is (Yes) not (No)
:Save the new quantity;
:Return the new cart;
|Customer|
:View the new cart;
stop

@enduml
