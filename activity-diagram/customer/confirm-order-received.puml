@startuml
!include https://static.visual-paradigm.com/web/resources/plantuml-stdlib/themes/vp.puml

title Order - Confirm Order Received

skinparam shadowing false
skinparam backgroundColor white
skinparam activityFontName Arial
skinparam activityFontSize 14
skinparam activityBorderThickness 1.5
skinparam ArrowThickness 1.5
skinparam ArrowColor #222222
skinparam SwimlaneBorderColor #222222
skinparam SwimlaneBorderThickness 2
skinparam activity {
  BackgroundColor #7DD3FC
  BorderColor #2563EB
  DiamondBackgroundColor #7DD3FC
  DiamondBorderColor #2563EB
  StartColor #111827
  EndColor #FFFFFF
}

|Customer|
start
note right
Precondition:
The customer is authenticated and owns an order
whose required shipments are all delivered.

Postcondition:
The order is COMPLETED. Without confirmation the
system completes it 3 days after the last delivery.
end note
:Open the details of the delivered order;
|System|
:Display the order and the confirm-received action;
|Customer|
:Confirm that the order was received;
|System|
if (The system fails while processing the request?) then (Yes)
  :Return the system error;
  |Customer|
  :View the system error;
  stop
else (No)
endif
|System|
:Check ownership and that the order is DELIVERED;
if (The order is DELIVERED?) then (No)
  :Return the order-cannot-be-confirmed error;
  |Customer|
  :View the order-cannot-be-confirmed error;
  stop
else (Yes)
  |System|
  :Mark the order as COMPLETED;
  :Return the result;
  |Customer|
  :View the result;
  stop
endif

@enduml
