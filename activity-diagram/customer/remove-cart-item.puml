@startuml
!include https://static.visual-paradigm.com/web/resources/plantuml-stdlib/themes/vp.puml

title Cart - Remove Cart Item

skinparam shadowing false
skinparam backgroundColor white
skinparam activityFontName Arial
skinparam activityFontSize 14
skinparam activityBorderThickness 1.5
skinparam ArrowThickness 1.5
skinparam ArrowColor #222222
skinparam SwimlaneBorderColor #222222
skinparam SwimlaneBorderThickness 2
skinparam activity {
  BackgroundColor #7DD3FC
  BorderColor #2563EB
  DiamondBackgroundColor #7DD3FC
  DiamondBorderColor #2563EB
  StartColor #111827
  EndColor #FFFFFF
}

|Customer|
start
note right
Precondition:
Customer is authenticated; the data belongs to
the Customer.

Postcondition:
The product is removed from the cart.
end note
:Open the cart or the product catalog;
|System|
:Display the related products;
|Customer|
:Select the product to remove;
:Confirm the cart change;
|System|
:Check the product and the remaining quantity;
if (A system error occurs while processing the request?) then (Yes)
  :Return the system error;
  |Customer|
  :View the system error;
  stop
else (No)
endif
|System|
:Update the cart and recalculate the total;
:Display the updated cart;
|Customer|
:View the result;
stop

@enduml
