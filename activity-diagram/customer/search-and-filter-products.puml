@startuml
!include https://static.visual-paradigm.com/web/resources/plantuml-stdlib/themes/vp.puml

title Catalog - Search and Filter Products

skinparam shadowing false
skinparam backgroundColor white
skinparam activityFontName Arial
skinparam activityFontSize 14
skinparam activityBorderThickness 1.5
skinparam ArrowThickness 1.5
skinparam ArrowColor #222222
skinparam SwimlaneBorderColor #222222
skinparam SwimlaneBorderThickness 2
skinparam activity {
  BackgroundColor #7DD3FC
  BorderColor #2563EB
  DiamondBackgroundColor #7DD3FC
  DiamondBorderColor #2563EB
  StartColor #111827
  EndColor #FFFFFF
}

|Customer|
start
note right
Precondition:
The customer is signed in.

Postcondition:
None.
end note
:Open the search;
|System|
:Display the search box and filters;
|Customer|
repeat
:Enter a keyword or choose filters and a sort;
:Submit the search;
|System|
if (The system fails while processing the request?) then (Yes)
  :Return the system error;
  |Customer|
  :View the system error;
  stop
else (No)
endif
|System|
:Check the minimum price is not above the maximum;
backward :Return the validation error;
repeat while (The minimum price is above the\nmaximum?) is (Yes) not (No)
:Find listed products whose name, category name or description contains the keyword (ignoring accents) and that pass the filters;
:If nothing matches, find the closest products in meaning and still apply the filters;
:Return the result page;
if (There is still no result?) then (Yes)
  :Return an empty list;
  |Customer|
  :View the message;
  stop
else (No)
endif
|System|
|Customer|
:View the results;
stop

@enduml
