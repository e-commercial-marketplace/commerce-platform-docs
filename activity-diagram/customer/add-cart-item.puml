@startuml
!include https://static.visual-paradigm.com/web/resources/plantuml-stdlib/themes/vp.puml

title Cart - Add Cart Item

skinparam shadowing false
skinparam backgroundColor white
skinparam activityFontName Arial
skinparam activityFontSize 14
skinparam activityBorderThickness 1.5
skinparam ArrowThickness 1.5
skinparam ArrowColor #222222
skinparam SwimlaneBorderColor #222222
skinparam SwimlaneBorderThickness 2
skinparam activity {
  BackgroundColor #7DD3FC
  BorderColor #2563EB
  DiamondBackgroundColor #7DD3FC
  DiamondBorderColor #2563EB
  StartColor #111827
  EndColor #FFFFFF
}

|Customer|
start
note right
Precondition:
Customer is authenticated; the data belongs
to the Customer.

Postcondition:
The product is added to the cart and the
cart quantity is updated.
end note
:Open the cart or the product catalog;
|System|
:Display the related products;
|Customer|
repeat
  :Select the product and the quantity to add;
  :Confirm the cart change;
  |System|
  if (Processing the request fails?) then (Yes)
    :Return the system error;
    |Customer|
    :View the system error;
    stop
  else (No)
  endif
  |System|
  :Check the product and the remaining quantity;
  if (The product is unavailable or the quantity exceeds the remaining stock?) then (Yes)
    :Return the cart-cannot-be-updated notice;
    |Customer|
    :View the cart-cannot-be-updated notice;
  else (No)
    |System|
    :Update the cart and recalculate the amount;
    :Display the updated cart;
    |Customer|
    :View the result;
    stop
  endif
  |Customer|
  :Correct the quantity or select another product;
repeat while (Add another\nitem?) is (Yes) not (No)
stop

@enduml
