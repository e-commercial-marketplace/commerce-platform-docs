@startuml
!include https://static.visual-paradigm.com/web/resources/plantuml-stdlib/themes/vp.puml

title Auth - Logout

skinparam shadowing false
skinparam backgroundColor white
skinparam activityFontName Arial
skinparam activityFontSize 14
skinparam activityBorderThickness 1.5
skinparam ArrowThickness 1.5
skinparam ArrowColor #222222
skinparam SwimlaneBorderColor #222222
skinparam SwimlaneBorderThickness 2
skinparam activity {
  BackgroundColor #7DD3FC
  BorderColor #2563EB
  DiamondBackgroundColor #7DD3FC
  DiamondBorderColor #2563EB
  StartColor #111827
  EndColor #FFFFFF
}

|Customer|
start
note right
Precondition:
The user is signed in and holds an active refresh token.

Postcondition:
The refresh token is revoked. The current access token
expires naturally (at most 15 minutes).
end note
:Choose logout;
:Submit the logout with the refresh token;
|System|
if (The system fails while processing the request?) then (Yes)
  :Return the system error;
  |Customer|
  :View the system error;
  stop
else (No)
endif
|System|
:Check the refresh token is active and belongs to the caller;
if (The refresh token is unknown, revoked or not the caller's?) then (Yes)
  :Return the invalid-token error;
  |Customer|
  :View the message;
  stop
else (No)
endif
|System|
:Revoke the refresh token;
|Customer|
:View the logout result;
stop

@enduml
