@startuml
!include https://static.visual-paradigm.com/web/resources/plantuml-stdlib/themes/vp.puml

title Catalog - Search and Filter Products

skinparam shadowing false
skinparam backgroundColor white
skinparam activityFontName Arial
skinparam activityFontSize 14
skinparam activityBorderThickness 1.5
skinparam ArrowThickness 1.5
skinparam ArrowColor #222222
skinparam SwimlaneBorderColor #222222
skinparam SwimlaneBorderThickness 2
skinparam activity {
  BackgroundColor #7DD3FC
  BorderColor #2563EB
  DiamondBackgroundColor #7DD3FC
  DiamondBorderColor #2563EB
  StartColor #111827
  EndColor #FFFFFF
}

|Guest|
start
note right
Precondition:
Guest is not authenticated.

Postcondition:
None.
end note
:Open the search and filter function;
|System|
:Display the products the Guest is allowed to view;
|Guest|
repeat
  :Enter a keyword or select a filter condition;
  :Submit the search request;
  |System|
  if (The system fails while processing the request?) then (Yes)
    :Return the system error;
    |Guest|
    :View the system error;
    stop
  else (No)
  endif
  |System|
  :Find the matching products;
  if (Matching products are found?) then (No)
    :Return the no-results notice;
    |Guest|
    :View the no-results notice;
  else (Yes)
    |System|
    :Display the results;
    |Guest|
    :View the results;
    stop
  endif
  |Guest|
  :Change the search conditions;
repeat while (Search\nagain?) is (Yes) not (No)
stop

@enduml
