@startuml
!include https://static.visual-paradigm.com/web/resources/plantuml-stdlib/themes/vp.puml

title Auth - Guest Login with Google

skinparam shadowing false
skinparam backgroundColor white
skinparam activityFontName Arial
skinparam activityFontSize 14
skinparam activityBorderThickness 1.5
skinparam ArrowThickness 1.5
skinparam ArrowColor #222222
skinparam SwimlaneBorderColor #222222
skinparam SwimlaneBorderThickness 2
skinparam activity {
  BackgroundColor #7DD3FC
  BorderColor #2563EB
  DiamondBackgroundColor #7DD3FC
  DiamondBorderColor #2563EB
  StartColor #111827
  EndColor #FFFFFF
}

|Guest|
start
note right
Precondition:
Guest is not authenticated and has a
Google account.

Postcondition:
The account is logged in when Google
confirms the identity. A Customer account
is created or linked when needed.
end note
:Open the login function;
|System|
:Display the Google sign-in option;
|Guest|
repeat
  :Choose to sign in with Google;
  :Select a Google account and grant consent;
  if (Guest cancels the Google consent?) then (Yes)
    :Close the Google sign-in window;
  else (No)
    :Submit the Google ID token;
    |System|
    if (The system fails while processing the request?) then (Yes)
      :Return the system error;
      |Guest|
      :View the system error;
      stop
    else (No)
    endif
    |System|
    :Verify the ID token with Google;
    if (The token is invalid or expired?) then (Yes)
      :Return the Google-sign-in-failed error;
      |Guest|
      :View the Google-sign-in-failed error;
    else (No)
      |System|
      if (The Google email is not verified?) then (Yes)
        :Return the Google-sign-in-failed error;
        |Guest|
        :View the Google-sign-in-failed error;
      else (No)
        |System|
        if (An account matches the Google ID or email?) then (No)
          :Create a Customer account linked to the Google ID;
        else (Yes)
          if (The account is not yet linked to Google?) then (Yes)
            :Link the Google ID to the account;
          else (No)
          endif
        endif
        if (The account is disabled?) then (Yes)
          :Return the account-unavailable error;
          |Guest|
          :View the account-unavailable error;
          stop
        else (No)
          |System|
          :Log in the account and return the result;
          |Guest|
          :View the login result;
          stop
        endif
      endif
    endif
  endif
  |Guest|
  :Decide to try signing in again;
repeat while (Sign in\nagain?) is (Yes) not (No)
stop

@enduml
